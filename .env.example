# Skopiuj ten plik jako .env i uzupełnij wartości
# cp .env.example .env

# Długi losowy string (min. 32 znaki) — możesz wygenerować: openssl rand -base64 32
JWT_SECRET=zmien-na-dlugi-losowy-string

# Hasło dostępu do czatu
ACCESS_PASSWORD=twoje-haslo

# URL frontendu (domena publiczna)
FRONTEND_URL=https://ai.twoja-domena.pl

# Postgres - logowanie rozmów + statystyk (patrz sekcja "Logi" w README)
POSTGRES_USER=aichat
POSTGRES_PASSWORD=zmien-na-inny-losowy-string
POSTGRES_DB=aichat

# PIN do panelu podglądu WSZYSTKICH pytań/odpowiedzi + statystyk w UI
# (osobny od ACCESS_PASSWORD - druga warstwa dostępu). Bez tego panel jest
# wyłączony. Nieustawione/puste = panel odrzuca każde logowanie.
ADMIN_PIN=zmien-na-wlasny-pin

# Odkomentuj tylko na hoście z kartą NVIDIA (patrz sekcja "GPU" w README)
# COMPOSE_PROFILES=gpu
